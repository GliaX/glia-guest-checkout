  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nConverted\nAbandoned", "default": "Open", "in_list_view": 1},
  {"fieldname": "email", "fieldtype": "Data", "label": "Email"},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
  {"fieldname": "contact", "fieldtype": "Link", "label": "Contact", "options": "Contact"},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency"},
  {"fieldname": "total", "fieldtype": "Currency", "label": "Total"},
  {"fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "options": "Sales Order", "read_only": 1},
  {"fieldname": "payment_request", "fieldtype": "Link", "label": "Payment Request", "options": "Payment Request", "read_only": 1},
  {"fieldname": "order_token", "fieldtype": "Data", "label": "Order Token", "read_only": 1},
  {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "Guest Cart Item"}
